  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Use Keycloak client_credentials at the configured issuer's /protocol/openid-connect/token endpoint. Audience defaults to runloom-execution."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
    "StartRequest": {
      "example": {"definition_id":"invoice","version":1,"input":{"invoice_id":"INV-42"}},
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition_id",
          "version"
        ],
        "properties": {
          "definition_id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          }
        }
      },
      "Workflow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "input_schema": {
            "type": "object"
          },
          "exposed_input_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "exposed_output_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "Run": {
        "type": "object",
        "required": [
          "id",
          "definition_id",
          "version",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "definition_id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "paused",
              "completed",
              "failed",
              "canceled",
              "terminated",
              "timedout",
              "continuedasnew"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "pause_reason": {
            "type": "string",
            "enum": ["llm_budget_limit", "llm_budget_accounting_unavailable"],
            "description": "Safe budget pause reason on run status reads. Paused is nonterminal; budget totals and policy details are not exposed."
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "Only explicitly granted fields; secret-like keys redacted"
          },
          "output": {
            "type": "object",
            "additionalProperties": true,
            "description": "Only explicitly granted fields when available; redacted"
          }
        }
      }
    }
  }
}
