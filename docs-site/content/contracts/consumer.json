{
  "openapi": "3.0.3",
  "info": {
    "title": "Runloom Consumer Execution API",
    "version": "1.0.0",
    "description": "For backend integrations using service-account access tokens with the dedicated execution audience. Required scopes must exist in BOTH the token and current account policy. Exact published workflow/version grants and owned root runs restrict access; another account's runs remain inaccessible even with identical grants. Removing a grant hides its prior runs. Studio tokens and direct child starts are rejected. No client secrets in browsers: obtain the token in your backend, then paste only that access token into Authorize. Input/output omitted by default. There are NO consumer stop, pause, resume or terminate endpoints; cancel is permanent cooperative cancellation, not a reversible pause. Try it out sends REAL requests and can cause external side effects and costs. Starts require a stable Idempotency-Key; use the same key/body after a timeout. Temporal history must not be purged during the five-minute ambiguous-start retry window. Idempotency keys never silently expire. Filesystem storage is bounded and intended for one API process."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/workflows": {
      "get": {
        "operationId": "listWorkflows",
        "summary": "List granted published workflow versions",
        "tags": ["Workflows"],
        "description": "Requires workflows:read in token and account policy. One item per granted published main version; no workflow steps or credentials. Schema defaults/examples are stripped. limit defaults to 50 (1–100); pass next_cursor as after until empty. Restart pagination after grants change.",
        "x-required-scope": "workflows:read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Workflow"
                      }
                    },
                    "next_cursor": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid, inactive or rotated credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope or workflow grant denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not visible",
