{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runloom schedule creation",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "definition_id", "version"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "definition_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "input": { "type": "object", "default": {} },
    "interval_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
    "cron": { "type": "string", "maxLength": 200, "pattern": "^\\s*\\S+(\\s+\\S+){4}\\s*$" },
    "time_zone": { "type": "string", "default": "UTC", "description": "Validated IANA zone for cron calendars." },
    "at": { "type": "string", "format": "date-time", "description": "Future RFC3339 instant with explicit offset." },
    "paused": { "type": "boolean", "default": false }
  },
  "oneOf": [
    { "required": ["interval_seconds"], "not": { "anyOf": [{ "required": ["cron"] }, { "required": ["at"] }] } },
    { "required": ["cron"], "not": { "anyOf": [{ "required": ["interval_seconds"] }, { "required": ["at"] }] } },
    { "required": ["at"], "not": { "anyOf": [{ "required": ["interval_seconds"] }, { "required": ["cron"] }] } }
  ]
}
