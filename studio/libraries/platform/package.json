{
  "name": "@runloom/studio-platform",
  "version": "1.8.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pack": "npm run build && npm pack ./dist --pack-destination releases",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,html,scss,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,html,scss,css,json}\""
  },
  "peerDependencies": {
    "@angular/common": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "keycloak-js": "26.2.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/common": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "ng-packagr": "22.1.1",
    "typescript": "~6.0.2",
    "rxjs": "~7.8.0",
    "prettier": "3.9.9"
  },
  "exports": {
    "./styles.scss": "./styles.scss"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "npm@11.20.0"
}
